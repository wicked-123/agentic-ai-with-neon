{
  "functions": {
    "api.py": {
      "maxDuration": 60,
      "includeFiles": "pro/**"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/dashboard", "destination": "/public/dashboard.html" },
    { "source": "/static/(.*)", "destination": "/public/$1" },
    { "source": "/(.*)", "destination": "/api.py" }
  ]
}
